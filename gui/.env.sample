# NEVER commit this file. Replace the placeholder values below.

# --- Required -------------------------------------------------------------
S3_BUCKET=my-impulse-bucket
AWS_REGION=us-east-1

# --- AWS credentials: pick ONE option --------------------------------------

# Option A: access keys (simplest on end-user machines)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# Only for temporary credentials (STS / assumed roles); otherwise leave empty
AWS_SESSION_TOKEN=

# Option B: a named profile from ~/.aws
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty and set the profile:
AWS_PROFILE=
AWS_CONFIG_DIR=~/.aws

# --- Optional -------------------------------------------------------------
# Filename the HathiTrust task writes its manifest to
HATHITRUST_MANIFEST_NAME=manifest.json

# Max upload size in bytes (default 500 MB)
MAX_CONTENT_LENGTH=524288000

# Web UI address. Use BIND_ADDR=0.0.0.0 to expose it on your network.
BIND_ADDR=127.0.0.1
WEB_PORT=5000

# Number of FireWorks workers running jobs in parallel
WORKER_REPLICAS=2

# Extra OS packages for your tasks (space-separated), used at build time
APT_PACKAGES=libgl1 libglib2.0-0
